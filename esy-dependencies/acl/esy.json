{
  "name": "esy-acl",
  "version": "0.1.0",
  "description": "esy-acl packaged for esy",
  "source": "https://download.savannah.nongnu.org/releases/acl/acl-2.3.2.tar.gz#sha256:5f2bdbad629707aa7d85c623f994aa8a1d2dec55a73de5205bac0bf6058a2f7c",
  "override": {
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "build": [
      [

      ],
      [
        "./configure",
        "--disable-silent-rules"
      ],
      [
        "make",
        "install"
      ]
    ],
    "install": "make install",
    "buildsInSource": true,
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    },
    "dependencies": {
      "esy-attr": "*",
      "esy-linux": "*"
    }
  }
}