{
  "name": "esy-gettext",
  "version": "0.1.0",
  "description": "esy-gettext packaged for esy",
  "esy": {
    "buildsInSource": true,
    "build": [
      [
        "./configure",
        "--disable-dependency-tracking",
        "--without-libunistring-prefix",
        "--disable-silent-rules",
        "--with-included-glib",
        "--with-included-libcroco",
        "--with-emacs",
        "--with-lispdir=#{self.etc}",
        "--disable-java",
        "--disable-csharp",
        "--without-git",
        "--without-cvs",
        "--without-xz",
        "--without-libxml2"
      ],
      [
        "make"
      ],
      [
        "make",
        "install"
      ]
    ],
    "install": "make install",
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    }
  },
  "dependencies": {}
}