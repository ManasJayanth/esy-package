{
  "name": "esy-utf8proc",
  "version": "0.1.0",
  "description": "esy-utf8proc packaged for esy",
  "source": "https://github.com/JuliaStrings/utf8proc/archive/refs/tags/v2.10.0.tar.gz#sha256:6f4f1b639daa6dca9f80bc5db1233e9cbaa31a67790887106160b33ef743f136",
  "override": {
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "build": [
      [
        "make"
      ]
    ],
    "install": "make install prefix=#{self.install}",
    "buildsInSource": true,
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    },
    "dependencies": {
    }
  }
}
