{
  "name": "esy-attr",
  "version": "0.1.0",
  "description": "esy-attr packaged for esy",
  "source": "https://download.savannah.nongnu.org/releases/attr/attr-2.5.2.tar.gz#sha256:39bf67452fa41d0948c2197601053f48b3d78a029389734332a6309a680c6c87",
  "override": {
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "build": [
      [
        "bash",
        "-lc",
        "if [ \"$(uname)\" = \"Darwin\" ]; then echo 'Skipping attr build on macOS'; exit 0; fi; set -e; ./configure --disable-silent-rules --disable-dependency-tracking --prefix=#{self.install}; sed -i'' -e '/#include <locale.h>/a\\\n#include <libgen.h>' tools/attr.c; make; make install"
      ]
    ],
    "install": "true",
    "buildsInSource": true,
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    },
    "dependencies": {
    }
  }
}
