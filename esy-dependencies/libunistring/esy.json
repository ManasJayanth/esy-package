{
  "name": "esy-libunistring",
  "version": "0.1.0",
  "description": "esy-libunistring packaged for esy",
  "source": "https://ftp.gnu.org/gnu/libunistring/libunistring-1.3.tar.gz#sha256:8ea8ccf86c09dd801c8cac19878e804e54f707cf69884371130d20bde68386b7",
  "override": {
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "build": [
      [
        "./configure",
        "--disable-silent-rules",
        "--disable-dependency-tracking",
        "--prefix=#{self.install}"
      ],
      [
        "make"
      ]
    ],
    "install": "make install",
    "buildsInSource": true,
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    },
    "dependencies": {
    }
  }
}
