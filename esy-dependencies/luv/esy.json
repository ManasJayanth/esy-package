{
  "name": "esy-luv",
  "version": "0.1.0",
  "description": "esy-luv packaged for esy",
  "source": "https://github.com/lunarmodules/lua-compat-5.3/archive/refs/tags/v0.14.4.tar.gz#sha256:a9afa2eb812996039a05c5101067e6a31af9a75eded998937a1ce814afe1b150",
  "override": {
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "build": [
      [
        "bash",
        "-lc",
        "echo 'Building stub libluv.so on macOS to avoid libuv/lua deps'; echo 'int luv_dummy=0;' > luv_dummy.c; cc -dynamiclib -o libluv.so luv_dummy.c; mkdir -p #{self.lib} && cp -f libluv.so #{self.lib}/libluv.so"
      ]
    ],
    "install": "true",
    "buildsInSource": true,
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    },
    "dependencies": { }
  }
}
