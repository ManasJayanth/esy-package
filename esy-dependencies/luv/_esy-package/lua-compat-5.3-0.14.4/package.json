{
  "name": "esy-luv",
  "version": "0.1.0",
  "description": "esy-luv packaged for esy",
  "esy": {
    "buildsInSource": true,
    "build": [
      [],
      [
        "cmake",
        "-S",
        ".",
        "-B",
        "buildjit",
        "-DWITH_LUA_ENGINE=LuaJIT",
        "-DBUILD_STATIC_LIBS=ON",
        "-DBUILD_SHARED_LIBS=ON",
        "-DWITH_SHARED_LIBUV=ON",
        "-DLUA_BUILD_TYPE=System",
        "-DLUA_COMPAT53_DIR=#{self.target}/deps/lua-compat-5.3",
        "-DBUILD_MODULE=ON"
      ],
      [
        "cmake",
        "--build",
        "buildjit"
      ],
      [
        "cmake",
        "--install",
        "buildjit"
      ],
      [
        "cmake",
        "-S",
        ".",
        "-B",
        "buildlua",
        "-DWITH_LUA_ENGINE=Lua",
        "-DBUILD_STATIC_LIBS=OFF",
        "-DBUILD_SHARED_LIBS=OFF",
        "-DWITH_SHARED_LIBUV=ON",
        "-DLUA_BUILD_TYPE=System",
        "-DLUA_COMPAT53_DIR=#{self.target}/deps/lua-compat-5.3",
        "-DBUILD_MODULE=ON",
        [],
        [
          "cmake",
          "-S",
          ".",
          "-B",
          "buildjit",
          "-DWITH_LUA_ENGINE=LuaJIT",
          "-DBUILD_STATIC_LIBS=ON",
          "-DBUILD_SHARED_LIBS=ON",
          "-DWITH_SHARED_LIBUV=ON",
          "-DLUA_BUILD_TYPE=System",
          "-DLUA_COMPAT53_DIR=#{self.target}/deps/lua-compat-5.3",
          "-DBUILD_MODULE=ON"
        ],
        [
          "cmake",
          "--build",
          "buildjit"
        ],
        [
          "cmake",
          "--install",
          "buildjit"
        ]
      ],
      [
        "cmake",
        "--build",
        "buildlua"
      ],
      [
        "cmake",
        "--install",
        "buildlua"
      ]
    ],
    "install": "make install",
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    }
  },
  "dependencies": {
    "esy-cmake": "*",
    "esy-lua": "*",
    "esy-luajit": "*",
    "esy-libuv": "*"
  }
}