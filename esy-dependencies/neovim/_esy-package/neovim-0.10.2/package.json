{
  "name": "esy-neovim",
  "version": "0.1.0",
  "description": "esy-neovim packaged for esy",
  "esy": {
    "buildsInSource": true,
    "build": [
      [],
      [
        "cmake",
        "-S",
        ".",
        "-B",
        "build",
        "-DLUV_LIBRARY=#{luv.lib}/libluv.so",
        "-DLIBUV_LIBRARY=#{libuv.lib}/libuv.so",
        "-DLPEG_LIBRARY=#{lpeg.lib}/liblpeg.so"
      ],
      [
        "cmake",
        "--build",
        "build"
      ],
      [
        "cmake",
        "--install",
        "build"
      ]
    ],
    "install": "make install",
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    }
  },
  "dependencies": {
    "esy-cmake": "*",
    "esy-gettext": "*",
    "esy-libuv": "*",
    "esy-lpeg": "*",
    "esy-luajit": "*",
    "esy-luv": "*",
    "esy-tree-sitter": "*",
    "esy-unibilium": "*",
    "esy-utf8proc": "*"
  }
}