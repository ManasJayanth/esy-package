{
  "name": "esy-libuv",
  "version": "0.1.0",
  "description": "esy-libuv packaged for esy",
  "esy": {
    "buildsInSource": true,
    "build": [
      [
        "bash",
        "-lc",
        "mkdir -p build && cd build && cmake .. -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=#{self.install}"
      ],
      [
        "bash",
        "-lc",
        "cmake --build build --config Release"
      ]
    ],
    "install": [
      [
        "bash",
        "-lc",
        "cmake --install build"
      ]
    ],
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    }
  },
  "dependencies": {
    "esy-cmake": "*"
  }
}