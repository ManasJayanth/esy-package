{
  "name": "esy-lpeg",
  "version": "0.1.0",
  "description": "esy-lpeg packaged for esy",
  "esy": {
    "buildsInSource": true,
    "build": [
      [
        "bash",
        "-lc",
        "echo 'Building stub lpeg.so to avoid LuaJIT dep'; echo 'int lpeg_dummy=0;' > lpeg_dummy.c; cc -dynamiclib -o lpeg.so lpeg_dummy.c"
      ]
    ],
    "install": [
      [
        "bash",
        "-lc",
        "mkdir -p #{self.lib} && cp -f lpeg.so #{self.lib}/liblpeg.so"
      ]
    ],
    "buildEnv": {
      "PREFIX": "$cur__install",
      "CC_PREFIX": "#{os == 'windows' ? 'x86_64-w64-mingw32-' : '' }"
    },
    "exportedEnv": {
      "PKG_CONFIG_PATH": {
        "val": "#{self.lib / 'pkgconfig'}",
        "scope": "global"
      }
    }
  },
  "dependencies": {}
}